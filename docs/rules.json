{
  "schema": 1,
  "rules": [
    {
      "id": "generator-case-concurrency",
      "rule": "生成器与 Judge 执行器均使用传入的 1–16 题并发；每线程独立生成及评分组件，完整历史索引在冻结输入保护下每进程仅加载一次；每题独立实录和补验轮次，主线程写入成功断点；续跑先核验冻结输入，仅跳过成功题。",
      "enforcement": "code",
      "code": ["src/iteration/runner.py::run_gen_experiment", "src/iteration/progress.py::ParallelCaseProgress", "scripts/iterate_branches.py::work"],
      "tests": ["tests/test_resume_data.py::test_generator_rejects_invalid_workers_before_requests", "tests/test_resume_data.py::test_generator_parallelism_is_bounded_and_rounds_remain_isolated", "tests/test_resume_data.py::test_generator_workers_share_one_pinned_history_index", "tests/test_history_shared_retriever.py", "tests/test_resume_data.py::test_changed_case_cannot_be_skipped_on_resume", "tests/test_branches.py::test_worker_forwards_case_concurrency_to_both_runners"]
    },
    {
      "id": "fewshot-model-reranking",
      "rule": "模型重排只使用经过历史时间与来源过滤的候选；当前输入不含目标答案。序号须唯一且属于召回候选；无效结果不缓存、不静默回退，缓存命中也检查来源。",
      "enforcement": "code",
      "code": ["src/generator/reranker.py::FewShotReranker", "src/generator/generator.py::ReplyGenerator"],
      "tests": ["tests/test_fewshot_reranker.py::test_real_history_filtered_answers_hidden_and_cache_reused", "tests/test_fewshot_reranker.py::test_invalid_selections_never_cached_or_silently_fallback", "tests/test_fewshot_reranker.py::test_changed_sources_rejected_including_cache_hits"]
    },
    {
      "id": "branch-accepted-development-fork",
      "rule": "并行新方向可显式继承同条件的已采用开发版；绑定来源分支及正式实验，核对材料、数据和完整补验净胜。拒绝未采用、过期或不一致的来源，不重签旧证据、不改变生产指针；新实验仍执行当前来源保护。",
      "enforcement": "code",
      "code": ["src/iteration/branches.py::_accepted_source", "src/iteration/branches.py::submit"],
      "tests": ["tests/test_branches.py::test_fork_accepted_development_uses_common_control", "tests/test_branches.py::test_fork_rejects_invalid_development_receipt"]
    },
    {
      "id": "branch-development-stage-limit",
      "rule": "仅开发比较的分支通过原开发门槛后保留开发版，停止在固定准入与固定轮之前，不更改生产指针；后续同分支提案继承有收益的开发版。",
      "enforcement": "code",
      "code": ["src/iteration/branches.py::advance", "src/iteration/branches.py::set_stage_limit", "src/iteration/branches.py::promote_experiment"],
      "tests": ["tests/test_branches.py::test_development_stage_limit_retains_winner_without_fixed_or_production", "tests/test_branches.py::test_direct_development_promotion_recovers_blocked_round"]
    },
    {
      "id": "development-frozen-failure-limit",
      "rule": "开发晋级与固定准入沿用冻结失败率上限；所有题目必须有最终记录，失败题单独计数并排除出有效对数，达到上限拒绝，成功分歧仍须完整独立补验，不改写已完成证据",
      "enforcement": "code",
      "code": ["src/iteration/gates.py::confirmed_metrics"],
      "tests": ["tests/test_record_contract.py::test_development_gate_uses_frozen_failure_limit"]
    },
    {
      "id": "embedding-adoption-and-supplement",
      "rule": "Embedding 主候选必须从原训练特征重建且保留原来源；推理时两侧编码完全相同须返回精确 0.5，其余输入保留网络概率；补验须显式开启，只补缺失 r1/r2，同一轮两方共享观察，已有证据损坏不得回退请求",
